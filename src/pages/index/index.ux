<template>
  <div class="page">
    <text class="score">{{ home }} - {{ away }}</text>
    <div class="btn btn-home" onclick="goalHome">
      <text class="btn-text">LOCAL</text>
    </div>
    <div class="btn btn-away" onclick="goalAway">
      <text class="btn-text">VISITA</text>
    </div>
  </div>
</template>

<script>
import vibrator from '@system.vibrator'

export default {
  private: {
    home: 0,
    away: 0
  },
  goalHome() {
    this.home += 1
    this.buzz()
  },
  goalAway() {
    this.away += 1
    this.buzz()
  },
  buzz() {
    try {
      vibrator.vibrate({ mode: 'short' })
    } catch (e) {}
  }
}
</script>

<style>
.page {
  width: 100%;
  height: 100%;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background-color: #000000;
}
.score {
  font-size: 56px;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 28px;
}
.btn {
  width: 150px;
  height: 88px;
  border-radius: 44px;
  margin-top: 14px;
  align-items: center;
  justify-content: center;
}
.btn-home {
  background-color: #1f7a3f;
}
.btn-away {
  background-color: #2b4c8c;
}
.btn-text {
  font-size: 28px;
  color: #ffffff;
}
</style>
